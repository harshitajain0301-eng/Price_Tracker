<Window x:Class="PriceDropCatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:conv="clr-namespace:PriceDropCatcher.Converters"
        mc:Ignorable="d"
        Title="PriceDropCatcher"
        MinWidth="1080" MinHeight="720"
        Width="1240" Height="820"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI, sans-serif">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullOrEmptyToVisibilityConverter x:Key="StringVis"/>
        <conv:HttpToImageConverter x:Key="HttpImage"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="White" Padding="20,16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.06" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="PriceDropCatcher" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="US market · Amazon · Walmart · eBay" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0">
                    <Border CornerRadius="10" Background="#F8FAFC" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="4" MinWidth="420">
                        <Grid>
                            <TextBlock Text="🔍" Margin="10,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Margin="36,0,8,0" VerticalAlignment="Center"
                                     BorderThickness="0" Background="Transparent"/>
                        </Grid>
                    </Border>
                    <Button Content="Search" Margin="10,0,0,0" Command="{Binding SearchCommand}" MinWidth="100"/>
                    <Button Content="Retry" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding RetryCommand}" MinWidth="88"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextAlignment="Right"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: SerpAPI + alerts + tracked -->
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.05" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="SerpAPI" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SerpApiKeyStatusText}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="16"/>
                        <TextBox Text="{Binding SerpApiKeyInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0" FontFamily="Consolas" FontSize="11"
                                 ToolTip="Paste your private API key from serpapi.com/manage-api-key"/>
                        <Button Content="Save API key" Margin="0,10,0,0" HorizontalAlignment="Stretch" Command="{Binding SaveApiKeyCommand}"/>
                        <TextBlock Text="Stored in your Windows user profile (not in the repo). Executable config still works if you prefer App.config."
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="14"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14" Margin="0,14,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.05" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="Alerts" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <ListBox ItemsSource="{Binding Notifications}" BorderThickness="0" Background="Transparent" Margin="0,10,0,0" MaxHeight="220"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10" Margin="0,0,0,8" Background="#F8FAFC">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" Padding="6,2" FontSize="10" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="14" Margin="0,14,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.05" Direction="270"/>
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="↻" Style="{StaticResource GhostButton}" Padding="8,4" Command="{Binding RefreshTrackedCommand}" ToolTip="Refresh"/>
                            <TextBlock Text="Tracked" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding TrackedProducts}" SelectedItem="{Binding SelectedTracked}" Margin="0,10,0,0" BorderThickness="0" Background="Transparent" MaxHeight="320"
                                 DisplayMemberPath="Name"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Main -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,0,0,12"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringVis}}"/>

                    <!-- Product card -->
                    <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.06" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="120" Height="120" CornerRadius="12" Background="#EEF2FF" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <Binding Path="CurrentProduct.ImageUrl" Converter="{StaticResource HttpImage}"/>
                                        </Image.Source>
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Source" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="📦" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentProduct.ImageUrl}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentProduct.ImageUrl}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentProduct.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentProduct}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Send a product URL from the extension to begin." Foreground="{StaticResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentProduct}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding HasCurrentProduct, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Page price:" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                    <TextBlock Text="{Binding CurrentProduct.PagePriceDisplay}" FontWeight="SemiBold" Margin="6,0,0,0" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border CornerRadius="20" Padding="14,6" HorizontalAlignment="Right">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource NeutralBadgeBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecommendationBrushKey}" Value="BuyBadgeBrush">
                                                    <Setter Property="Background" Value="{StaticResource BuyBadgeBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RecommendationBrushKey}" Value="WaitBadgeBrush">
                                                    <Setter Property="Background" Value="{StaticResource WaitBadgeBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RecommendationBadgeText}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <TextBlock Text="{Binding Recommendation.Reason}" TextWrapping="Wrap" MaxWidth="260" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Skeleton -->
                    <Border Margin="0,14,0,0" CornerRadius="12" Background="#E2E8F0" Height="72" Visibility="{Binding IsLoadingPage, Converter={StaticResource BoolToVis}}">
                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <Border Height="10" Background="#CBD5E1" CornerRadius="4" Width="220" HorizontalAlignment="Left"/>
                            <Border Height="10" Background="#CBD5E1" CornerRadius="4" Width="160" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>

                    <!-- Comparison summary -->
                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16" Margin="0,0,8,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Lowest" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding LowestPriceDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16" Margin="8,0,0,0" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Average" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding AveragePriceDisplay}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- DataGrid -->
                    <Border Margin="0,14,0,0" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="0,0,0,8" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.05" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Market comparison" Margin="16,14,16,8" FontWeight="SemiBold" FontSize="14"/>
                            <Border Height="120" Background="#F8FAFC" Margin="16,0,16,8" CornerRadius="10" Visibility="{Binding IsLoadingPrices, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Fetching Google Shopping results…" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <DataGrid ItemsSource="{Binding PriceRows}" MinHeight="200" MaxHeight="360">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="*" MinWidth="100"/>
                                    <DataGridTextColumn Header="Price" Binding="{Binding PriceDisplay}" Width="120"/>
                                    <DataGridTextColumn Header="Rating" Binding="{Binding Rating, StringFormat={}{0:0.#}}" Width="80"/>
                                    <DataGridTextColumn Header="Offer" Binding="{Binding Offer}" Width="2*" MinWidth="120"/>
                                    <DataGridTemplateColumn Header="Link" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Open" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11"
                                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Link}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBestDeal}" Value="True">
                                                <Setter Property="Background" Value="#ECFDF5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Chart -->
                    <Border Margin="0,14,0,0" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Height="280">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.05" Direction="270"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="Price trend (lowest offer snapshots)" Margin="4,4,4,8" FontWeight="SemiBold" FontSize="14"/>
                            <lvc:CartesianChart Series="{Binding SeriesCollection}" LegendLocation="None" Hoverable="False" AnimationsSpeed="0:0:0.2" Height="210">
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis Title="USD" LabelFormatter="{Binding YFormatter}" Foreground="{StaticResource TextMutedBrush}"/>
                                </lvc:CartesianChart.AxisY>
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis LabelsRotation="-15" Foreground="{StaticResource TextMutedBrush}"/>
                                </lvc:CartesianChart.AxisX>
                            </lvc:CartesianChart>
                        </StackPanel>
                    </Border>

                    <!-- Track -->
                    <Border Margin="0,14,0,0" Background="{StaticResource CardBrush}" CornerRadius="14" Padding="16" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="200" Margin="0,0,12,0">
                                <TextBlock Text="Alert threshold (USD)" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBox Text="{Binding ThresholdText, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Button Content="Track product" VerticalAlignment="Bottom" Command="{Binding TrackCommand}" MinWidth="140"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
