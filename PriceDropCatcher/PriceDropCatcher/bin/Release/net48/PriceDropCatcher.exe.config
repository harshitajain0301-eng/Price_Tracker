<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Set your SerpAPI key (https://serpapi.com). Required for live shopping results. -->
    <add key="SerpApiKey" value="8a09b290bee6b8f374d8da5b635c4fd107ee7930672c4994b636033f6ebfe423" />
    <!-- Background monitor interval in minutes (30–60 recommended). -->
    <add key="PriceMonitorIntervalMinutes" value="45" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>